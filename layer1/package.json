{
  "name": "project",
  "version": "1.0.0",
  "description": "Blockchain Voting System with ZK Rollup Layer 2 Scalability",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "compile": "hardhat compile",
    "quick-start": "hardhat run scripts/quick-start.ts",
    "quick-start:sepolia": "hardhat run scripts/quick-start.ts --network sepolia",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:local": "npx hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "manage": "ts-node --files scripts/manage-election.ts",
    "manage:sepolia": "HARDHAT_NETWORK=sepolia npx ts-node --files scripts/manage-election.ts",
    "performance": "hardhat run analysis/performance-test.ts",
    "performance:sepolia": "hardhat run analysis/performance-test.ts --network sepolia",
    "performance:analysis": "hardhat run analysis/performance-analysis.ts",
    "performance:analysis:sepolia": "hardhat run analysis/performance-analysis.ts --network sepolia",
    "server": "ts-node backend/server.ts",
    "server:dev": "nodemon --exec ts-node backend/server.ts",
    "monitor": "ts-node backend/monitor.ts",
    "node": "hardhat node",
    "coverage": "hardhat coverage",
    "build": "tsc",
    "start": "node dist/server.js",
    "zk:compile": "circom circuits/VoteCircuit.circom --wasm --output keys/",
    "zk:keys": "ts-node scripts/zk-proof.ts --keys",
    "zk:verifier": "ts-node scripts/zk-proof.ts --verifier",
    "zk:demo": "ts-node scripts/zk-proof.ts --demo",
    "zk:deploy": "hardhat run scripts/deploy-zk.ts",
    "zk:deploy:local": "npx hardhat run scripts/deploy-zk.ts --network localhost",
    "zk:benchmark": "ts-node analysis/benchmark-l2.ts",
    "zk:benchmark:voters": "ts-node analysis/benchmark-l2.ts --voters=10000",
    "zk:benchmark:full": "ts-node analysis/benchmark-l2.ts --voters=100000 --batch=100",
    "l2:frontend": "npx http-server frontend -p 8080",
    "l2:frontend:prod": "npx http-server frontend -p 3000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.2",
    "hardhat-gas-reporter": "^2.3.0",
    "merkletreejs": "^0.6.0",
    "nodemon": "^3.1.11",
    "snarkjs": "^0.7.6",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0"
  }
}
